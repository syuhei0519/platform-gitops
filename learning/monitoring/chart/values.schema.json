{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "accountNamespace",
    "images"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "accountNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^learning-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "prometheus",
        "grafana"
      ],
      "properties": {
        "collector": {
          "const": "ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.161.0@sha256:b5cf983651c32c3ca13f936deb51742015a54d121f388cac248923ddeb8cc9fc"
        },
        "prometheus": {
          "const": "quay.io/prometheus/prometheus:v3.15.0@sha256:86b17a25c2db1d16a61b16b3c8f336679eb19e26333d03e808da387206e40faa"
        },
        "grafana": {
          "const": "docker.io/grafana/grafana:13.2.3@sha256:d84563330dc9d2fd2bc096d0fb96021b5319c75bf6ed555566709998e823dec4"
        }
      }
    }
  }
}
