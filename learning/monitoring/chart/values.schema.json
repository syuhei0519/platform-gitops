{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "accountNamespace",
    "images"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "accountNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^learning-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "prometheus",
        "grafana"
      ],
      "properties": {
        "collector": {
          "const": "ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.161.0@sha256:b5cf983651c32c3ca13f936deb51742015a54d121f388cac248923ddeb8cc9fc"
        },
        "prometheus": {
          "const": "quay.io/prometheus/prometheus:v3.15.0@sha256:86b17a25c2db1d16a61b16b3c8f336679eb19e26333d03e808da387206e40faa"
        },
        "grafana": {
          "const": "docker.io/grafana/grafana:13.2.5@sha256:9f7aa1e1e3246aade5792d35a738049f7f32f89cd51d1956cf426a4e86268a84"
        }
      }
    },
    "alerting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "alertmanagerImage",
        "receiverImage",
        "accountServiceName",
        "accountServicePort"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "const": "learning-slo-alerts"
        },
        "alertmanagerImage": {
          "const": "quay.io/prometheus/alertmanager:v0.32.0@sha256:58e117eabccebbff04e6643a3432d6315a2cc3a8c24ab5849bc628886bf08857"
        },
        "receiverImage": {
          "const": "docker.io/library/python:3.14.0-slim@sha256:0aecac02dc3d4c5dbb024b753af084cafe41f5416e02193f1ce345d671ec966e"
        },
        "accountServiceName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "accountServicePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
