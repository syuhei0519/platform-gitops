{
  "version": 1,
  "entry": "learning/existing-kind/bootstrap-root.yaml",
  "root": "learning/existing-kind/root/children.yaml",
  "server": "https://kubernetes.default.svc.cluster.local:443",
  "controlNamespace": "learning-progressive-control",
  "projects": {
    "learning-existing": {
      "sourceRepos": [
        "https://github.com/syuhei0519/platform-gitops.git",
        "https://github.com/syuhei0519/application-manifest.git"
      ],
      "destinations": [
        "istio-learning-system",
        "learning-account-release",
        "learning-istio-demo",
        "learning-progressive-control",
        "learning-services-20261018",
        "observability"
      ]
    },
    "account-release": {
      "sourceRepos": [
        "https://github.com/syuhei0519/application-manifest.git"
      ],
      "destinations": [
        "learning-account-release"
      ]
    }
  },
  "applications": {
    "lab-learning-foundation": {
      "repo": "platform-gitops",
      "path": "learning/existing-kind/managed/foundation",
      "project": "learning-existing",
      "destination": "learning-progressive-control",
      "resourceCount": 57,
      "allowedNamespaces": [
        "",
        "istio-learning-system",
        "learning-progressive-control"
      ],
      "allowedKinds": [
        "ConfigMap", "CustomResourceDefinition", "Deployment", "MutatingWebhookConfiguration",
        "Namespace", "Service", "ServiceAccount", "StatefulSet", "ValidatingAdmissionPolicy",
        "ValidatingAdmissionPolicyBinding", "ValidatingWebhookConfiguration"
      ]
    },
    "lab-learning-services": {
      "repo": "application-manifest",
      "path": "learning/existing-kind/services",
      "project": "learning-existing",
      "destination": "learning-services-20261018",
      "resourceCount": 24,
      "allowedKinds": ["ConfigMap", "Deployment", "PersistentVolumeClaim", "Service", "StatefulSet"]
    },
    "lab-learning-observability": {
      "repo": "platform-gitops",
      "path": "learning/existing-kind/managed/observability",
      "project": "learning-existing",
      "destination": "observability",
      "resourceCount": 16,
      "allowedKinds": ["ConfigMap", "Deployment", "Service", "ServiceAccount"]
    },
    "lab-learning-mesh-fixture": {
      "repo": "platform-gitops",
      "path": "learning/existing-kind/adoption/mesh-fixture",
      "project": "learning-existing",
      "destination": "learning-istio-demo",
      "resourceCount": 5,
      "allowedKinds": ["ConfigMap", "Deployment", "Service", "ServiceAccount"]
    },
    "lab-learning-rollouts": {
      "repo": "platform-gitops",
      "path": "learning/existing-kind/managed/rollouts",
      "project": "learning-existing",
      "destination": "learning-services-20261018",
      "resourceCount": 2,
      "allowedKinds": ["ConfigMap", "Deployment"]
    },
    "lab-learning-account-foundation": {
      "repo": "application-manifest",
      "path": "learning/existing-kind/account-foundation",
      "project": "learning-existing",
      "destination": "learning-account-release",
      "resourceCount": 7,
      "allowedKinds": ["ConfigMap", "Deployment", "Job", "PersistentVolumeClaim", "Service", "StatefulSet"]
    },
    "account-release-definition": {
      "repo": "application-manifest",
      "path": "learning/account-release/application-chart",
      "project": "learning-existing",
      "destination": "learning-progressive-control",
      "chartTemplateCount": 1,
      "allowedKinds": ["Application"]
    }
  },
  "secretReferences": [
    "argocd-redis",
    "argocd-repo-server-mtls",
    "argocd-repo-server-tls",
    "cacerts",
    "istio-kubeconfig",
    "istiod-tls",
    "learning-account-db",
    "learning-notification-db",
    "learning-order-db",
    "learning-payment-db"
  ],
  "persistentVolumeClaims": {
    "learning-account-release/learning-account-data": {
      "storageClassName": "standard",
      "accessModes": ["ReadWriteOnce"],
      "volumeName": null
    },
    "learning-services-20261018/learning-account-data": {
      "storageClassName": "standard",
      "accessModes": ["ReadWriteOnce"],
      "volumeName": "pvc-9ea2064f-271a-4a97-af7f-110750dc3af6"
    },
    "learning-services-20261018/learning-notification-data": {
      "storageClassName": "standard",
      "accessModes": ["ReadWriteOnce"],
      "volumeName": "pvc-3b432a3c-2f56-427d-bc93-ddabd02d0d73"
    },
    "learning-services-20261018/learning-order-data": {
      "storageClassName": "standard",
      "accessModes": ["ReadWriteOnce"],
      "volumeName": "pvc-9cc73725-b2a9-4aff-81ee-e48bb75d732c"
    },
    "learning-services-20261018/learning-payment-data": {
      "storageClassName": "standard",
      "accessModes": ["ReadWriteOnce"],
      "volumeName": "pvc-247463c7-eec2-4942-b50a-25ca810f0387"
    }
  },
  "jobs": {
    "learning-account-release/account-release-migration": {
      "owner": "application-manifest/learning/existing-kind/account-foundation",
      "lifecycle": "mutable-until-first-success-then-frozen"
    }
  }
}
