{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "tools", "identity", "steps"],
  "properties": {
    "rolloutsPlugin": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "sourceRevision", "controllerImage", "binarySha256", "bundleSha256"],
      "properties": {
        "profile": {"const": "fresh-account"},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "controllerImage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*@sha256:[0-9a-f]{64}$"},
        "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "schemaVersion": {"const": "platform.lab/approved-live-step-plan/v3"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["clusterName", "context", "kubeconfig"],
      "properties": {
        "clusterName": {"type": "string", "pattern": "^learning-fresh-[a-z0-9-]+$"},
        "context": {"type": "string", "pattern": "^kind-learning-fresh-[a-z0-9-]+$"},
        "kubeconfig": {"type": "string", "minLength": 3}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["kubectl", "kind", "helm", "istioctl", "argocd", "rollouts"],
      "properties": {
        "kubectl": {"$ref": "#/definitions/tool"}, "kind": {"$ref": "#/definitions/tool"},
        "helm": {"$ref": "#/definitions/tool"}, "istioctl": {"$ref": "#/definitions/tool"},
        "argocd": {"$ref": "#/definitions/tool"}, "rollouts": {"$ref": "#/definitions/tool"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["clusterUID"],
      "properties": {"clusterUID": {"$ref": "#/definitions/command"}}
    },
    "steps": {
      "type": "object", "additionalProperties": false,
      "required": ["preflight", "image-source", "cluster", "empty-node-cache", "image-import", "crds", "controllers", "security-boundary", "credential-bootstrap", "custom-resources", "database", "role-bootstrap", "migration", "application", "acceptance"],
      "properties": {
        "preflight": {"$ref": "#/definitions/step"}, "image-source": {"$ref": "#/definitions/step"},
        "cluster": {"$ref": "#/definitions/step"}, "empty-node-cache": {"$ref": "#/definitions/step"},
        "image-import": {"$ref": "#/definitions/step"}, "crds": {"$ref": "#/definitions/step"},
        "controllers": {"$ref": "#/definitions/step"}, "security-boundary": {"$ref": "#/definitions/step"},
        "credential-bootstrap": {"$ref": "#/definitions/step"}, "custom-resources": {"$ref": "#/definitions/step"},
        "database": {"$ref": "#/definitions/step"}, "role-bootstrap": {"$ref": "#/definitions/step"},
        "migration": {"$ref": "#/definitions/step"}, "application": {"$ref": "#/definitions/step"},
        "acceptance": {"$ref": "#/definitions/step"}
      }
    }
  },
  "definitions": {
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "version"],
      "properties": {"path": {"type": "string", "minLength": 1},
                     "sha256": {"pattern": "^[0-9a-f]{64}$"},
                     "version": {"type": "string", "minLength": 1}}
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["tool", "args", "contentSha256"],
      "properties": {"tool": {"enum": ["kubectl", "kind", "helm", "istioctl", "argocd", "rollouts"]},
                     "args": {"type": "array", "items": {"type": "string"}},
                     "contentSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "verify", "reconcile", "run", "resourceIdentities", "observations", "hostArtifacts"],
      "properties": {
        "phase": {"enum": ["pre-cluster", "cluster-create", "post-cluster"]},
        "verify": {"type": "array", "items": {"$ref": "#/definitions/command"}},
        "reconcile": {"type": "array", "items": {"$ref": "#/definitions/command"}},
        "run": {"type": "array", "items": {"$ref": "#/definitions/command"}},
        "resourceIdentities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observations": {"type": "array", "items": {"$ref": "#/definitions/observation"}},
        "hostArtifacts": {"type": "array", "items": {"$ref": "#/definitions/hostArtifact"}}
      }
    },
    "hostArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "sizeBytes", "sourceIdentity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "sourceIdentity": {"type": "string", "minLength": 3}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "identity", "desiredPaths", "desiredSha256", "generationPolicy", "healthPolicy", "requiredConditions", "requiredImageDigests"],
      "properties": {
        "apiVersion": {"type": "string", "pattern": "^(v1|[a-z0-9.-]+/v[0-9]+((alpha|beta)[0-9]+)?)$"},
        "identity": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]*/[A-Za-z0-9.-]+/[A-Za-z0-9.-]+$"},
        "desiredPaths": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}},
        "desiredSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generationPolicy": {"enum": ["none", "observed-current"]},
        "healthPolicy": {"enum": ["none", "conditions", "workload-ready", "job-complete", "pvc-bound", "statefulset-ready", "rollout-ready", "argocd-operation-succeeded", "argocd-application-ready", "node-cache-empty", "node-images-present"]},
        "requiredConditions": {"type": "object", "additionalProperties": {"enum": ["True", "False", "Unknown"]}},
        "requiredImageDigests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    }
  }
}

