{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "tools", "identity", "steps"],
  "properties": {
    "schemaVersion": {"const": "platform.lab/approved-live-step-plan/v2"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["clusterName", "context", "kubeconfig"],
      "properties": {
        "clusterName": {"type": "string", "pattern": "^learning-fresh-[a-z0-9-]+$"},
        "context": {"type": "string", "pattern": "^kind-learning-fresh-[a-z0-9-]+$"},
        "kubeconfig": {"type": "string", "minLength": 3}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["kubectl", "kind", "helm", "istioctl", "argocd", "rollouts"],
      "properties": {
        "kubectl": {"$ref": "#/definitions/tool"}, "kind": {"$ref": "#/definitions/tool"},
        "helm": {"$ref": "#/definitions/tool"}, "istioctl": {"$ref": "#/definitions/tool"},
        "argocd": {"$ref": "#/definitions/tool"}, "rollouts": {"$ref": "#/definitions/tool"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["clusterUID"],
      "properties": {"clusterUID": {"$ref": "#/definitions/command"}}
    },
    "steps": {
      "type": "object", "additionalProperties": false,
      "required": ["preflight", "image-source", "cluster", "empty-node-cache", "image-import", "crds", "controllers", "security-boundary", "credential-bootstrap", "custom-resources", "database", "role-bootstrap", "migration", "application", "acceptance"],
      "properties": {
        "preflight": {"$ref": "#/definitions/step"}, "image-source": {"$ref": "#/definitions/step"},
        "cluster": {"$ref": "#/definitions/step"}, "empty-node-cache": {"$ref": "#/definitions/step"},
        "image-import": {"$ref": "#/definitions/step"}, "crds": {"$ref": "#/definitions/step"},
        "controllers": {"$ref": "#/definitions/step"}, "security-boundary": {"$ref": "#/definitions/step"},
        "credential-bootstrap": {"$ref": "#/definitions/step"}, "custom-resources": {"$ref": "#/definitions/step"},
        "database": {"$ref": "#/definitions/step"}, "role-bootstrap": {"$ref": "#/definitions/step"},
        "migration": {"$ref": "#/definitions/step"}, "application": {"$ref": "#/definitions/step"},
        "acceptance": {"$ref": "#/definitions/step"}
      }
    }
  },
  "definitions": {
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "version"],
      "properties": {"path": {"type": "string", "minLength": 1},
                     "sha256": {"pattern": "^[0-9a-f]{64}$"},
                     "version": {"type": "string", "minLength": 1}}
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["tool", "args"],
      "properties": {"tool": {"enum": ["kubectl", "kind", "helm", "istioctl", "argocd", "rollouts"]},
                     "args": {"type": "array", "items": {"type": "string"}}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["verify", "reconcile", "run", "resourceIdentities", "observations"],
      "properties": {
        "verify": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/command"}},
        "reconcile": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/command"}},
        "run": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/command"}},
        "resourceIdentities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/observation"}}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "identity", "desiredPaths", "desiredSha256", "generationPolicy", "healthPolicy", "requiredConditions"],
      "properties": {
        "apiVersion": {"type": "string", "pattern": "^(v1|[a-z0-9.-]+/v[0-9]+((alpha|beta)[0-9]+)?)$"},
        "identity": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]*/[A-Za-z0-9.-]+/[A-Za-z0-9.-]+$"},
        "desiredPaths": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}},
        "desiredSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generationPolicy": {"enum": ["none", "observed-current"]},
        "healthPolicy": {"enum": ["none", "conditions", "workload-ready", "job-complete", "pvc-bound", "statefulset-ready", "rollout-ready"]},
        "requiredConditions": {"type": "object", "additionalProperties": {"enum": ["True", "False", "Unknown"]}}
      }
    }
  }
}

