    "release-definition": {"repository": "https://github.com/syuhei0519/application-manifest.git", "commit": "f019cc9ad76abdd49a6be303bd4e5c88050abc85", "path": "learning/fresh-profile/release-definition"}
  },
  "applications": [
    {"actor": "platform", "name": "account-lightweight-root", "namespace": "fresh-control", "project": "fresh-platform", "repository": "https://github.com/syuhei0519/platform-gitops.git", "revision": "__PLATFORM_GITOPS_SHA__", "path": "learning/fresh-profile/root/children", "sourceConfig": {"directory": {"recurse": true}}, "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-control"}},
    {"actor": "release-definition", "name": "fresh-release-definitions", "namespace": "fresh-control", "project": "fresh-platform", "repository": "https://github.com/syuhei0519/application-manifest.git", "revision": "f019cc9ad76abdd49a6be303bd4e5c88050abc85", "path": "learning/fresh-profile/release-definition", "sourceConfig": {"helm": {"releaseName": "fresh-account-release-definition", "parameters": [{"name": "workloadRevision", "value": "f019cc9ad76abdd49a6be303bd4e5c88050abc85"}, {"name": "accountRuntimeImage", "value": "PENDING_PLAT211_VERIFIED_IMAGE"}]}}, "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-control"}},
    {"actor": "platform", "name": "fresh-observability", "namespace": "fresh-control", "project": "fresh-platform", "repository": "https://github.com/syuhei0519/platform-gitops.git", "revision": "__PLATFORM_GITOPS_SHA__", "path": "learning/fresh-profile/observability", "sourceConfig": {"directory": {"recurse": true}}, "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-observability"}},
    {"actor": "workload", "name": "fresh-account-release", "namespace": "fresh-control", "project": "fresh-account", "repository": "https://github.com/syuhei0519/application-manifest.git", "revision": "f019cc9ad76abdd49a6be303bd4e5c88050abc85", "path": "learning/fresh-profile/workload", "sourceConfig": {"kustomize": {"images": ["ghcr.io/syuhei0519/backend-app=PENDING_PLAT211_VERIFIED_IMAGE"]}}, "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-account"}}
  ],
  "operations": [
    {"actor": "platform", "verb": "create", "scope": "namespace", "namespace": "fresh-control", "apiGroup": "argoproj.io", "resource": "applications", "name": "account-lightweight-root"},
    {"actor": "release-definition", "verb": "create", "scope": "namespace", "namespace": "fresh-control", "apiGroup": "argoproj.io", "resource": "applications", "name": "fresh-account-release"},
    {"actor": "workload", "verb": "create", "scope": "namespace", "namespace": "fresh-account", "apiGroup": "argoproj.io", "resource": "rollouts", "name": "account-api"},
    {"actor": "workload", "verb": "create", "scope": "namespace", "namespace": "fresh-account", "apiGroup": "batch", "resource": "jobs", "name": "account-migration"},
    {"actor": "workload", "verb": "create", "scope": "namespace", "namespace": "fresh-account", "apiGroup": "", "resource": "persistentvolumeclaims", "name": "account-data"}
  ],
  "controllers": [
    {
      "kind": "StatefulSet", "namespace": "fresh-account", "name": "account-postgresql",
      "podSpec": {
        "serviceAccountName": "account-database", "automountServiceAccountToken": false,
        "containers": [{"name": "postgresql", "securityContext": {"privileged": false, "allowPrivilegeEscalation": false}, "env": [{"name": "POSTGRES_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-bootstrap", "key": "admin-password"}}}]}],
        "volumes": []
      }
    },
    {
      "kind": "Job", "namespace": "fresh-account", "name": "account-db-role-bootstrap",
      "podSpec": {
        "serviceAccountName": "account-migration", "automountServiceAccountToken": false, "restartPolicy": "Never",
        "containers": [{"name": "bootstrap", "securityContext": {"privileged": false, "allowPrivilegeEscalation": false}, "env": [
          {"name": "PGPASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-bootstrap", "key": "admin-password"}}},
          {"name": "MIGRATION_USERNAME", "valueFrom": {"secretKeyRef": {"name": "account-db-migration", "key": "username"}}},
          {"name": "MIGRATION_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-migration", "key": "password"}}},
          {"name": "RUNTIME_USERNAME", "valueFrom": {"secretKeyRef": {"name": "account-db-runtime", "key": "username"}}},
          {"name": "RUNTIME_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-runtime", "key": "password"}}}
        ]}],
        "volumes": []
      }
    },
    {
      "kind": "Rollout", "namespace": "fresh-account", "name": "account-api",
      "podSpec": {
        "serviceAccountName": "account-runtime", "automountServiceAccountToken": false,
        "containers": [{"name": "api", "securityContext": {"privileged": false, "allowPrivilegeEscalation": false}, "env": [{"name": "PGUSER", "valueFrom": {"secretKeyRef": {"name": "account-db-runtime", "key": "username"}}}, {"name": "PGPASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-runtime", "key": "password"}}}]}],
        "volumes": []
      }
    },
    {
      "kind": "Job", "namespace": "fresh-account", "name": "account-migration",
      "podSpec": {
        "serviceAccountName": "account-migration", "automountServiceAccountToken": false, "restartPolicy": "Never",
        "containers": [{"name": "migration", "securityContext": {"privileged": false, "allowPrivilegeEscalation": false}, "env": [{"name": "PGUSER", "valueFrom": {"secretKeyRef": {"name": "account-db-migration", "key": "username"}}}, {"name": "PGPASSWORD", "valueFrom": {"secretKeyRef": {"name": "account-db-migration", "key": "password"}}}]}],
        "volumes": []
      }
    }
  ],
  "retained": {
    "secretObjectsInGit": false,
    "secretReferences": ["account-db-bootstrap/admin-password", "account-db-migration/username", "account-db-migration/password", "account-db-runtime/username", "account-db-runtime/password"],
    "persistentVolumeClaims": {"fresh-account/account-data": {"storageClassName": "standard", "accessModes": ["ReadWriteOnce"], "syncOptions": ["Prune=false", "Delete=false"]}},
    "jobs": {"fresh-account/account-db-role-bootstrap": "sync-wave-10-retained-on-success-never-recreated-by-resume", "fresh-account/account-migration": "sync-wave-20-retained-on-success-never-recreated-by-rerun-or-resume"},
    "fieldOwners": {
      "Application/fresh-control/account-lightweight-root": "platform",
      "Application/fresh-control/fresh-release-definitions": "platform",
      "Application/fresh-control/fresh-account-release": "release-definition",
      "Rollout/fresh-account/account-api": "workload",
      "PersistentVolumeClaim/fresh-account/account-data": "workload"
    }
  }
}
