{
  "schemaVersion": "platform.lab/fresh-security-contract/v1",
  "profile": "account-lightweight-fresh",
  "destinationServer": "https://kubernetes.default.svc",
  "approvedRuntimeImage": "PENDING_PLAT211_VERIFIED_IMAGE",
  "namespaces": {
    "fresh-control": {"platform.lab/profile": "account-lightweight-fresh", "platform.lab/security-boundary": "control"},
    "fresh-account": {"platform.lab/profile": "account-lightweight-fresh", "platform.lab/security-boundary": "account", "istio.io/rev": "fresh-1-31-2"},
    "fresh-observability": {"platform.lab/profile": "account-lightweight-fresh", "platform.lab/security-boundary": "observability"}
  },
  "applications": {
    "account-lightweight-root": {
      "namespace": "fresh-control", "project": "fresh-platform",
      "repository": "https://github.com/syuhei0519/platform-gitops.git",
      "revision": "__PLATFORM_GITOPS_SHA__", "path": "learning/fresh-profile/root/children",
      "sourceConfig": {"directory": {"recurse": true}},
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-control"}
    },
    "fresh-release-definitions": {
      "namespace": "fresh-control", "project": "fresh-platform",
      "repository": "https://github.com/syuhei0519/application-manifest.git",
      "revision": "b759f1bd4976e0269740c10421c5537e35be72dd", "path": "learning/fresh-profile/release-definition",
      "sourceConfig": {"helm": {"releaseName": "fresh-account-release-definition", "parameters": [
        {"name": "workloadRevision", "value": "b759f1bd4976e0269740c10421c5537e35be72dd"},
        {"name": "accountRuntimeImage", "value": "PENDING_PLAT211_VERIFIED_IMAGE"}
      ]}},
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-control"}
    },
    "fresh-observability": {
      "namespace": "fresh-control", "project": "fresh-platform",
      "repository": "https://github.com/syuhei0519/platform-gitops.git",
      "revision": "__PLATFORM_GITOPS_SHA__", "path": "learning/fresh-profile/observability",
      "sourceConfig": {"directory": {"recurse": true}},
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-observability"}
    },
    "fresh-account-release": {
      "namespace": "fresh-control", "project": "fresh-account",
      "repository": "https://github.com/syuhei0519/application-manifest.git",
      "revision": "b759f1bd4976e0269740c10421c5537e35be72dd", "path": "learning/fresh-profile/workload",
      "sourceConfig": {"kustomize": {"images": ["ghcr.io/syuhei0519/backend-app=PENDING_PLAT211_VERIFIED_IMAGE"]}},
      "destination": {"server": "https://kubernetes.default.svc", "namespace": "fresh-account"}
    }
  },
  "controllers": {
    "StatefulSet/fresh-account/account-postgresql": {
      "serviceAccountName": "account-database", "allowedSecretKeys": {"account-db-bootstrap": ["admin-password"]}
    },
    "Job/fresh-account/account-db-role-bootstrap": {
      "serviceAccountName": "account-migration",
      "allowedSecretKeys": {"account-db-bootstrap": ["admin-password"], "account-db-migration": ["username", "password"], "account-db-runtime": ["username", "password"]}
    },
    "Job/fresh-account/account-migration": {
      "serviceAccountName": "account-migration", "allowedSecretKeys": {"account-db-migration": ["uri"]}
    },
    "Rollout/fresh-account/account-api": {
      "serviceAccountName": "account-runtime", "allowedSecretKeys": {"account-db-runtime": ["uri"]}
    }
  },
  "resourceNames": {
    "fresh-control": {"argoproj.io/applications": ["account-lightweight-root", "fresh-account-release", "fresh-observability", "fresh-release-definitions"]},
    "fresh-account": {
      "/configmaps": ["account-role-bootstrap"], "/persistentvolumeclaims": ["account-data"],
      "/services": ["account-api", "account-postgresql"], "/serviceaccounts": ["account-database", "account-migration", "account-runtime"],
      "apps/statefulsets": ["account-postgresql"], "batch/jobs": ["account-db-role-bootstrap", "account-migration"],
      "argoproj.io/rollouts": ["account-api"], "networking.istio.io/destinationrules": ["account-api"],
      "networking.istio.io/virtualservices": ["account-api"]
    },
    "fresh-observability": {
      "/configmaps": ["otel-collector", "prometheus"], "/services": ["grafana", "otel-collector", "prometheus"],
      "/serviceaccounts": ["grafana", "otel-collector", "prometheus"],
      "apps/deployments": ["grafana", "otel-collector"], "apps/statefulsets": ["prometheus"]
    }
  },
  "bootstrapResourceNames": {
    "fresh-control": {"argoproj.io/appprojects": ["fresh-account", "fresh-platform"]}
  },
  "rbacRuleContract": {
    "discoveryVerbs": ["get", "list", "watch"], "createVerbs": ["create"],
    "namedMutationVerbs": ["get", "update", "patch"], "deleteVerbs": [],
    "createIsBoundedByFailClosedAdmission": true
  },
  "podCreationBoundary": {
    "trustedCreateRequestor": "system:kube-controller-manager",
    "namespacedPodCreateSubjects": [],
    "ownerReferenceUidLookupInCel": false,
    "guarantee": "CREATE Pod requires trusted kube-controller-manager requestor plus canonical controller owner shape; namespaced GitOps and workload identities receive no Pod create verb",
    "liveEvidence": ["audit-create-username", "kubectl-auth-can-i-no-direct-pod", "fake-owner-direct-pod-denied", "ephemeralcontainers-subresource-denied"]
  },
  "liveEvidence": {
    "required": ["kubectl-auth-can-i-positive", "kubectl-auth-can-i-negative", "admission-positive", "admission-negative"],
    "status": "required-unrun"
  }
}
