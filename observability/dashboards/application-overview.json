    {
      "id": 8,
      "type": "table",
      "title": "Source SHA / service version by process",
      "description": "job/instance -> service_version (build-time source SHA). Compare release.sourceCommit and Pod imageID. SHA is not copied into every histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "target_info{job=\"account-backend\"}",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Per-instance request rate / source version",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job,instance) (rate(pe_http_server_requests_total{job=\"account-backend\"}[5m])) * on(job,instance) group_left(service_version) target_info{job=\"account-backend\"}",
          "legendFormat": "{{instance}} / {{service_version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
