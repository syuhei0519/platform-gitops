{
  "uid": "core-application-overview",
  "title": "Core Platform v1 — アプリケーションの概要",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "core-platform-v1"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate / second",
      "description": "Backend reached requests only. Each source instance rate before aggregation; health excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pe_http_server_requests_total{job=\"account-backend\"}[5m]))",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API estimated requests / 5m",
      "description": "PromQL extrapolated estimate; SDK reader count is exact. Export10s/scrape30s/window5m.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pe_http_server_requests_total{job=\"account-backend\"}[5m]))",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API 5xx ratio",
      "description": "No traffic removes series and displays N/A; zero denominator is never presented as a success ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pe_http_server_requests_total{job=\"account-backend\",status_class=\"5xx\"}[5m])) or vector(0)) / sum(rate(pe_http_server_requests_total{job=\"account-backend\"}[5m])) and on() (sum(rate(pe_http_server_requests_total{job=\"account-backend\"}[5m])) > 0)",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API p50 seconds",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le) (rate(pe_http_server_request_duration_seconds_bucket{job=\"account-backend\"}[5m])))",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
