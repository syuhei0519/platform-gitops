    {
      "id": 7,
      "type": "timeseries",
      "title": "Backend Pod Ready",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,pod) (kube_pod_status_ready{namespace=\"account\",pod=~\"backend-.*\",condition=\"true\"})",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
