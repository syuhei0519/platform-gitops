        {
          "refId": "A",
          "expr": "sum by(status_class) (rate(pe_http_server_requests_total{job=\"account-backend\"}[5m]))",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
