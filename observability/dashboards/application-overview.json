        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(pe_http_server_request_duration_seconds_bucket{job=\"account-backend\"}[5m])))",
          "legendFormat": "{{namespace}} / {{pod}} {{job}} {{instance}} {{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
