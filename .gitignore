# ローカルのビルド結果や一時ファイルを、Git の変更一覧から除くための設定です。
*.local.yaml
.env*
.rendered/
.build/
.security/
.validation/
.oci/
.oci-budget-*/
.tools/
learning/fresh-profile/.runtime/
learning/fresh-profile/*.runtime.local.yaml
learning/fresh-profile/*.runtime.local.json
learning/existing-kind/.runtime/
learning/existing-kind/*.runtime.local.yaml
learning/existing-kind/*.runtime.local.json
learning/sonarqube/.runtime/
__pycache__/

# Generated evidence stays in CI artifacts.
/docs/implementation/evidence/**
!/docs/implementation/evidence/
!/docs/implementation/evidence/README.md

# Generated evidence stays in CI artifacts.
/learning/istio/evidence/**
!/learning/istio/evidence/
!/learning/istio/evidence/README.md

# Generated evidence stays in CI artifacts.
/learning/istio/rendered/**
!/learning/istio/rendered/
!/learning/istio/rendered/README.md

# Immutable shared modules are materialized by ci/shared-tools.sh.
/tools/scan-gate/
